# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cresvyn.tech@gmail.com
SMTP_PASS=Anand@99
