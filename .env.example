# Copy this file to .env and fill in the values (never commit .env)

PORT=3000

# Password for https://yourdomain.com/admin  (username can be anything, e.g. "admin")
ADMIN_PASSWORD=change-me-to-something-long

# Where contact-form enquiries are emailed
